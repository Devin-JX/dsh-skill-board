{
  "name": "@devin-jx/dsh-skill-board",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "A Skills page in DSH Settings: list every model-invocable skill and toggle it on or off.",
  "keywords": ["dsh", "deepseek-harness", "cordis", "plugin", "agent-skills"],
  "author": "Devin-JX",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}